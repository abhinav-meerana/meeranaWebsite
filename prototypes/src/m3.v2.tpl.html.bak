<script>
{{M3_SCENE_JS}}
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  'use strict';
  var S = window.M3Scene, FM = S.formations, R = S.R, U = S.U;
  var root = document.documentElement, body = document.body;
  var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var mqFine = window.matchMedia('(pointer: fine)');
  var mqWide = window.matchMedia('(min-width: 1024px)');
  function isReduced() { return mqReduce.matches || root.dataset.motion === 'reduce'; }
  function $$(sel, el) { return Array.prototype.slice.call((el || document).querySelectorAll(sel)); }
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  // QA hooks for design review screenshots: #qa=<beat>&webgl=force|off&t=<seconds> renders that state, settled.
  var Q = {}; location.hash.replace(/^#/, '').split('&').forEach(function (kv) { var p = kv.split('='); if (p[0]) Q[p[0]] = p.length > 1 ? decodeURIComponent(p[1]) : '1'; });

  var stage = document.getElementById('stage'), posters = stage.querySelector('.posters'), canvas = stage.querySelector('canvas');
  var probes = { main: stage.querySelector('.rect-main.probe'), wide: stage.querySelector('.rect-wide.probe') };
  var vw = 0, vh = 0, rects = {};
  function measure() {   // cached on resize only: never read layout inside the animation loop
    vw = window.innerWidth; vh = window.innerHeight;
    for (var k in probes) { var r = probes[k].getBoundingClientRect(); rects[k] = { x: r.left, y: r.top, w: r.width, h: r.height }; }
  }
  measure();
  function framing(f) { var b = f.box, r = rects[f.rect] || rects.main, s = Math.min(r.w / b.w, r.h / b.h);
    return { s: s, cx: b.cx, cy: b.cy, px: r.x + r.w / 2, py: r.y + r.h / 2 }; }
  // product formations sit behind the glass gallery, larger and centred
  for (var k0 = 0; k0 < 7; k0++) if (FM['layer' + k0]) FM['layer' + k0].rect = 'wide';

  /* ---------------- overlays (glass chips pinned to scene anchors) ---------------- */
  var ovls = $$('[data-ovl]', stage).map(function (el) { return { el: el, f: el.dataset.ovl.split(' '), a: el.dataset.anchor, on: false }; });
  function overlaysFor(name, on) {
    ovls.forEach(function (o) { var v = on && o.f.indexOf(name) >= 0 && !!FM[name].anchors[o.a]; o.on = v; o.el.classList.toggle('is-on', v); }); }
  var ovlEl = stage.querySelector('.ovl'), lastS = 0;
  function placeOverlays(name, project, s) {
    var f = FM[name]; if (!f) return;
    if (s && Math.abs(s - lastS) > 0.25) { lastS = s; ovlEl.style.setProperty('--s', s.toFixed(2)); }
    ovls.forEach(function (o) { if (!o.on) return; var xy = project(f.anchors[o.a]);
      o.el.style.transform = 'translate3d(' + xy[0].toFixed(1) + 'px,' + xy[1].toFixed(1) + 'px,0)'; });
  }
  function posterProject(f) { var fr = framing(f);
    var fn = function (p) { return [fr.px + (S.dot(p, R) - fr.cx) * fr.s, fr.py - (S.dot(p, U) - fr.cy) * fr.s]; }; fn.s = fr.s; return fn; }

  /* ---------------- poster mode (no WebGL, small screens): same shapes as SVG, cross-faded ---------------- */
  var mode = 'poster', current = 'hero', GL = null;
  function posterShow(name, instant) {
    var f = FM[name], olds = posters.querySelectorAll('.m3p');
    if (olds.length === 1 && olds[0].dataset.f === name) { overlaysFor(name, true); var pp = posterProject(f); placeOverlays(name, pp, pp.s); return; }
    var tmp = document.createElement('div'); tmp.innerHTML = S.poster(f, 'rect-' + f.rect);
    var svg = tmp.firstChild; posters.appendChild(svg); overlaysFor(name, false);
    function swap() { svg.classList.add('is-on'); olds.forEach(function (o) { o.classList.remove('is-on'); setTimeout(function () { o.remove(); }, instant ? 0 : 260); });
      overlaysFor(name, true); var pp = posterProject(f); placeOverlays(name, pp, pp.s); }
    if (instant || isReduced()) swap(); else requestAnimationFrame(function () { requestAnimationFrame(swap); });
  }
  function show(name, instant) { if (!FM[name]) return; current = name; if (mode === 'gl') GL.go(name, instant); else posterShow(name, instant); }

  /* ---------------- beats → scene states; chapter, island and timeline UI ---------------- */
  var BEATS = { hero: 'hero', world: 'world', 'story-0': 'bay1', 'story-1': 'bay1', 'story-2': 'bay2', 'story-3': 'bay3',
                'story-4': 'bars', 'story-5': 'bay5', next: 'next' };
  for (var li = 0; li < 7; li++) BEATS['layer-' + li] = 'layer' + li;
  var CH = { hero: ['01', 'Intelligence'], layer: ['02', 'Products'], world: ['03', 'Offices'], story: ['04', 'How it works'], next: ['05', 'What’s next'] };
  var PRODUCTS = ['Mandoobee', 'Tasree3', 'Nazo', 'Yisbir', 'Wasel', 'Asset Tracking', 'AI in a Box'];
  var ACT = { 'story-2': ['danger', 'Yisbir · smoke detected · CAM-07'], 'story-3': ['', 'Alert → duty officer · task R-0142'],
              'story-4': ['', 'Bay 3 · 6 of 7 events after hours'], 'story-5': ['', 'R-0142 closed · one record'] };
  var beatEls = $$('[data-beat]');
  var chNo = $$('[data-ch-no]'), chName = $$('[data-ch-name]'), navLinks = $$('[data-nav]'), tlItems = $$('[data-tl]'), tlFill = document.querySelector('.tl-fill');
  var beat = null, moment = null;
  function setBeat(b) {
    if (b === beat) return;
    beat = b; body.dataset.scene = b;
    if (b !== 'hero') { stopAutoplay(); setMoment(null); }
    show(b === 'hero' && moment ? moment : BEATS[b]);
    var key = b.split('-')[0], ch = CH[key] || CH.hero, name = key === 'layer' ? PRODUCTS[+b.split('-')[1]] : ch[1];
    chNo.forEach(function (e) { e.textContent = ch[0]; }); chName.forEach(function (e) { e.textContent = name; });
    navLinks.forEach(function (a) { if (a.dataset.nav === key) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
    var step = key === 'story' ? +b.split('-')[1] : 0;
    tlItems.forEach(function (t) { var n = +t.dataset.tl; if (n === step) t.setAttribute('aria-current', 'step'); else t.removeAttribute('aria-current');
      if (n < step) t.setAttribute('data-done', ''); else t.removeAttribute('data-done'); });
    if (tlFill) tlFill.style.transform = 'scaleY(' + (step > 1 ? (step - 1) / 4 : 0) + ')';
    if (ACT[b]) activity(ACT[b][0], ACT[b][1]);
  }

  /* ---------------- Dynamic Island ---------------- */
  var island = document.querySelector('[data-island]'), sheet = document.getElementById('isl-sheet'), menuBtn = island.querySelector('[data-isl-menu]');
  var islLayers = { compact: island.querySelector('.isl-compact'), expanded: island.querySelector('.isl-full'), activity: island.querySelector('.isl-activity') };
  var actText = island.querySelector('[data-act-text]'), islState = '', islHover = false, islPinned = false, actTimer = 0, ringP = island.querySelector('.rp');
  function islApply(st) {
    if (st === islState) return; islState = st; island.dataset.state = st;
    for (var k in islLayers) { var on = k === st; islLayers[k].setAttribute('aria-hidden', String(!on)); islLayers[k].inert = !on; }
  }
  function islBase() { return mqWide.matches && (window.scrollY < 80 || islHover || islPinned) ? 'expanded' : 'compact'; }
  function islUpdate() { if (!actTimer) islApply(islBase()); }
  function activity(tone, text) {   // a "live activity": the island widens to report one event, then settles back
    if (isReduced()) return;
    clearTimeout(actTimer); actText.textContent = text; islLayers.activity.dataset.tone = tone; islApply('activity');
    actTimer = setTimeout(function () { actTimer = 0; islUpdate(); }, 2600);
  }
  island.addEventListener('pointerenter', function () { if (mqFine.matches && !actTimer) { islHover = true; islUpdate(); } });
  island.addEventListener('pointerleave', function () { islHover = false; islUpdate(); });
  island.addEventListener('focusin', function () { islHover = true; clearTimeout(actTimer); actTimer = 0; islUpdate(); });
  island.addEventListener('focusout', function (e) { if (!island.contains(e.relatedTarget)) { islHover = false; islUpdate(); } });
  function openSheet(open) {
    if (open) { sheet.setAttribute('data-open', ''); sheet.inert = false; } else { sheet.removeAttribute('data-open'); sheet.inert = true; }
    menuBtn.setAttribute('aria-expanded', String(open)); menuBtn.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
  }
  menuBtn.addEventListener('click', function () {
    if (mqWide.matches) { islPinned = true; islHover = true; islUpdate(); var first = islLayers.expanded.querySelector('a[href^="#products"]'); if (first) first.focus(); }
    else openSheet(!sheet.hasAttribute('data-open'));
  });
  $$('a', sheet).forEach(function (a) { a.addEventListener('click', function () { openSheet(false); }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { openSheet(false); islPinned = false; islHover = false; islUpdate(); } });
  document.addEventListener('pointerdown', function (e) { if (!island.contains(e.target) && !sheet.contains(e.target)) { islPinned = false; openSheet(false); islUpdate(); } });
  islUpdate();

  /* ---------------- hero: four rapid moments (autoplay once, then on demand) ---------------- */
  var SEQ = ['ai', 'auto', 'iot', 'sec'], HOLD = 1500, apTimer = 0, apIdx = -1;
  var momentBtns = $$('[data-moment]');
  function setMoment(m) { moment = m; momentBtns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.moment === m)); }); }
  function stopAutoplay() { clearTimeout(apTimer); apIdx = -1; }
  function stepAutoplay() {
    if (beat !== 'hero' || isReduced()) { stopAutoplay(); return; }
    if (apIdx < SEQ.length) { setMoment(SEQ[apIdx]); show(SEQ[apIdx]); apIdx++; apTimer = setTimeout(stepAutoplay, HOLD); }
    else { setMoment(null); show('hero'); apIdx = -1; }
  }
  function autoplay(delay) { stopAutoplay(); if (isReduced() || beat !== 'hero' || Q.qa) return; apIdx = 0; apTimer = setTimeout(stepAutoplay, delay || 0); }
  momentBtns.forEach(function (b, i) {
    b.addEventListener('click', function () { stopAutoplay(); var m = b.dataset.moment;
      if (moment === m) { setMoment(null); show('hero'); } else { setMoment(m); show(m); } });
    function hi(on) { if (GL) GL.stream(on ? i + 1 : 0); }   // hovering a moment brightens its input stream into the core
    b.addEventListener('mouseenter', function () { hi(true); }); b.addEventListener('mouseleave', function () { hi(false); });
    b.addEventListener('focus', function () { hi(true); }); b.addEventListener('blur', function () { hi(false); });
  });
  document.querySelector('[data-replay]').addEventListener('click', function () { setMoment(null); show('hero'); autoplay(500); });

  /* ---------------- product gallery: pinned horizontal scroll (desktop) or swipe rail ---------------- */
  var hs = document.getElementById('products'), hsPin = hs.querySelector('.hs-pin'), vp = hs.querySelector('.hs-viewport'), track = hs.querySelector('.hs-track');
  var cards = $$('.pcard', track), hsCount = hs.querySelector('[data-hs-count]'), hsGo = $$('[data-hs-go]', hs);
  var hsActive = -1, hsTween = null, hsST = null, hsCardTLs = [], hsIO = null, inGallery = false;
  function setCard(i) {
    i = Math.max(0, Math.min(cards.length - 1, i));
    if (i !== hsActive) {
      hsActive = i; hsCount.textContent = pad(i + 1);
      hsGo.forEach(function (b, j) { if (j === i) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); });
      cards.forEach(function (c, j) { if (j === i) c.setAttribute('data-active', ''); else c.removeAttribute('data-active'); });
      syncVideos();
    }
    if (inGallery) setBeat('layer-' + i);
  }
  function syncVideos() {
    $$('video', track).forEach(function (v) {
      var card = v.closest('.pcard'), want = !isReduced() && card.hasAttribute('data-active') && v.classList.contains('is-on') && inGallery;
      if (want) { if (v.preload !== 'auto') v.preload = 'auto'; var p = v.play(); if (p && p.catch) p.catch(function () {}); } else if (!v.paused) v.pause();
    });
  }
  function hsTeardown() {
    if (hsST) { hsCardTLs.forEach(function (t) { t.scrollTrigger && t.scrollTrigger.kill(); t.kill(); }); hsCardTLs = []; hsST.kill(); hsTween.kill(); hsST = hsTween = null;
      gsap.set(track, { clearProps: 'transform' }); gsap.set(cards, { clearProps: 'all' }); }
    if (hsIO) { hsIO.disconnect(); hsIO = null; }
    hs.classList.remove('is-pinned');
  }
  function hsBuild() {
    hsTeardown();
    var pinned = mqWide.matches && !isReduced() && window.gsap && window.ScrollTrigger;
    if (pinned) {
      hs.classList.add('is-pinned');
      var dist = function () { return track.scrollWidth - vp.clientWidth; };
      hsTween = gsap.to(track, { x: function () { return -dist(); }, ease: 'none', scrollTrigger: {
        trigger: hs, pin: hsPin, start: 'top top', end: function () { return '+=' + dist(); }, scrub: 0.4, invalidateOnRefresh: true, refreshPriority: 1,
        onToggle: function (st) { inGallery = st.isActive; if (st.isActive) setCard(Math.round(st.progress * (cards.length - 1))); syncVideos(); },
        onUpdate: function (st) { setCard(Math.round(st.progress * (cards.length - 1))); } } });
      hsST = hsTween.scrollTrigger;
      cards.forEach(function (c) {   // each panel fades and turns in, holds while centred, then fades and turns out
        hsCardTLs.push(gsap.timeline({ scrollTrigger: { trigger: c, containerAnimation: hsTween, start: 'left right', end: 'right left', scrub: true } })
          .fromTo(c, { opacity: 0.2, scale: 0.9, rotationY: -18, z: -140 }, { opacity: 1, scale: 1, rotationY: 0, z: 0, ease: 'power2.out', duration: 1 })
          .to(c, { duration: 0.5 })
          .to(c, { opacity: 0.2, scale: 0.92, rotationY: 16, z: -140, ease: 'power2.in', duration: 1 }));
      });
    } else {
      hsIO = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting && e.intersectionRatio > 0.55) setCard(+e.target.dataset.i); }); },
        { root: vp, threshold: [0.55, 0.8] });
      cards.forEach(function (c) { hsIO.observe(c); });
    }
    setCard(Math.max(0, hsActive));
  }
  function hsGoTo(i) {
    i = Math.max(0, Math.min(cards.length - 1, i));
    if (hsST) { window.scrollTo({ top: hsST.start + (hsST.end - hsST.start) * i / (cards.length - 1) + 1, behavior: isReduced() ? 'auto' : 'smooth' }); }
    else { var c = cards[i]; vp.scrollTo({ left: c.offsetLeft - (vp.clientWidth - c.offsetWidth) / 2, behavior: isReduced() ? 'auto' : 'smooth' }); }
  }
  $$('[data-hs-step]', hs).forEach(function (b) { b.addEventListener('click', function () { hsGoTo(hsActive + Number(b.dataset.hsStep)); }); });
  hsGo.forEach(function (b) { b.addEventListener('click', function () { hsGoTo(+b.dataset.hsGo); }); });
  cards.forEach(function (c, i) {   // keyboard: focus inside a panel brings it to the centre (no focus trapped off-screen)
    c.addEventListener('focusin', function () { if (i !== hsActive) { if (hsST) window.scrollTo(0, hsST.start + (hsST.end - hsST.start) * i / (cards.length - 1) + 1); else setCard(i); } });
  });
  // screens inside a panel: tabs cross-fade; the frame opens the lightbox
  $$('.pcard').forEach(function (c) {
    var shots = $$('.shot', c), tabs = $$('[data-tabs] button', c);
    function showShot(n) { shots.forEach(function (s, j) { s.classList.toggle('is-on', j === n); }); tabs.forEach(function (t, j) { t.setAttribute('aria-pressed', String(j === n)); }); syncVideos(); }
    tabs.forEach(function (t, j) { t.addEventListener('click', function () { showShot(j); }); });
    var frame = c.querySelector('[data-zoom]');
    if (frame) frame.addEventListener('click', function () { var n = Math.max(0, shots.findIndex(function (s) { return s.classList.contains('is-on'); })); openLightbox(c, n); });
  });
  var lb = document.querySelector('.lightbox'), lbImg = lb.querySelector('img'), lbCap = lb.querySelector('[data-lb-cap]'), lbShots = [], lbN = 0;
  function lbShow(n) {
    lbN = (n + lbShots.length) % lbShots.length; var s = lbShots[lbN];
    lbImg.src = s.tagName === 'VIDEO' ? s.getAttribute('poster') : s.currentSrc || s.src; lbImg.alt = s.getAttribute('alt') || s.getAttribute('aria-label') || '';
    lbCap.textContent = (lbN + 1) + ' / ' + lbShots.length + ' · ' + lbImg.alt;
  }
  function openLightbox(card, n) { lbShots = $$('.shot', card); if (!lbShots.length) return; lbShow(n); var y = window.scrollY; if (lb.showModal) lb.showModal(); if (window.scrollY !== y) window.scrollTo(0, y); }
  $$('[data-lb-step]', lb).forEach(function (b) { b.addEventListener('click', function () { lbShow(lbN + Number(b.dataset.lbStep)); }); });
  lb.querySelector('[data-lb-close]').addEventListener('click', function () { lb.close(); });
  lb.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') lbShow(lbN + 1); if (e.key === 'ArrowLeft') lbShow(lbN - 1); });
  lb.addEventListener('click', function (e) { if (e.target === lb) lb.close(); });

  /* ---------------- glass micro-interactions: pointer sheen + screen tilt (rects cached on enter) ---------------- */
  if (mqFine.matches) {
    var lit = null, litRect = null;
    document.addEventListener('pointerover', function (e) {
      var g = e.target.closest && e.target.closest('.glass, .glass-strong');
      if (g === lit) return; if (lit) lit.classList.remove('is-lit'); lit = g; litRect = g ? g.getBoundingClientRect() : null; if (g) g.classList.add('is-lit');
    }, { passive: true });
    document.addEventListener('pointermove', function (e) {
      if (!lit || !litRect) return; lit.style.setProperty('--mx', (e.clientX - litRect.left) + 'px'); lit.style.setProperty('--my', (e.clientY - litRect.top) + 'px');
    }, { passive: true });
    window.addEventListener('scroll', function () { if (lit) litRect = null; }, { passive: true });
    $$('.pc-frame').forEach(function (f) {
      var r = null;
      f.addEventListener('pointerenter', function () { r = f.getBoundingClientRect(); });
      f.addEventListener('pointermove', function (e) { if (!r || isReduced()) return;
        f.style.setProperty('--ry', (((e.clientX - r.left) / r.width - 0.5) * 6).toFixed(2) + 'deg');
        f.style.setProperty('--rx', (-((e.clientY - r.top) / r.height - 0.5) * 5).toFixed(2) + 'deg'); }, { passive: true });
      f.addEventListener('pointerleave', function () { f.style.setProperty('--rx', '0deg'); f.style.setProperty('--ry', '0deg'); });
    });
  }

  /* ---------------- offices: live local time (true telemetry, updated every 30 s) ---------------- */
  var clocks = $$('[data-tz]');
  function tickClocks() { var now = new Date(); clocks.forEach(function (el) { try { el.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: el.dataset.tz }).format(now); } catch (e) {} }); }
  tickClocks(); setInterval(tickClocks, 30000);

  /* ---------------- Pause motion (WCAG 2.2.2) = on-page reduced motion, persisted ---------------- */
  var toggles = $$('[data-motion-toggle]');
  function syncToggle() { toggles.forEach(function (t) { t.setAttribute('aria-pressed', String(isReduced())); t.setAttribute('aria-label', isReduced() ? 'Resume motion' : 'Pause motion'); }); }
  function motionChanged() { syncToggle(); stopAutoplay(); syncVideos(); if (GL) GL.kick(); if (window.ScrollTrigger) { hsBuild(); ScrollTrigger.refresh(); } }
  toggles.forEach(function (t) { t.addEventListener('click', function () {
    if (root.dataset.motion === 'reduce') { delete root.dataset.motion; try { localStorage.removeItem('meerana-motion'); } catch (e) {} }
    else { root.dataset.motion = 'reduce'; try { localStorage.setItem('meerana-motion', 'reduce'); } catch (e) {} }
    motionChanged();
  }); });
  mqReduce.addEventListener('change', motionChanged);
  syncToggle();

  /* ---------------- scroll: GSAP ScrollTrigger is the single owner (IntersectionObserver if the CDN fails) ---------------- */
  function initScroll() {
    if (window.gsap && window.ScrollTrigger) {
      gsap.registerPlugin(ScrollTrigger);
      hsBuild();   // the pinned gallery first: every later trigger is measured after its pin spacer exists
      beatEls.forEach(function (el) {
        ScrollTrigger.create({ trigger: el, start: 'top 58%', end: 'bottom 58%', onToggle: function (st) { if (st.isActive) setBeat(el.dataset.beat); } });
      });
      ScrollTrigger.create({ start: 0, end: 'max', onUpdate: function (st) { ringP.style.strokeDashoffset = (56.55 * (1 - st.progress)).toFixed(2); islUpdate(); } });
      ['#story', '#contact'].forEach(function (sel) {   // scrubbed: the scene turns a few degrees as the chapter scrolls
        ScrollTrigger.create({ trigger: sel, start: 'top bottom', end: 'bottom top', onUpdate: function (st) { if (GL) GL.drift(st.progress - 0.5); } });
      });
      mqWide.addEventListener('change', function () { hsBuild(); ScrollTrigger.refresh(); });
      ScrollTrigger.refresh();
      if (document.fonts) document.fonts.ready.then(function () { ScrollTrigger.refresh(); });
      window.addEventListener('load', function () { ScrollTrigger.refresh(); });
    } else if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) setBeat(e.target.dataset.beat); }); }, { rootMargin: '-42% 0px -42% 0px' });
      beatEls.forEach(function (el) { io.observe(el); });
      hsBuild();
    }
    // rail mode (or no GSAP): the gallery counts as "in view" while the section crosses the middle of the screen
    if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { es.forEach(function (e) {
      if (hsST) return; inGallery = e.isIntersecting; if (inGallery) setCard(Math.max(0, hsActive)); syncVideos(); }); }, { rootMargin: '-45% 0px -45% 0px' }).observe(hs);
    if (!beat) setBeat('hero');
  }

{{M3_ENGINE_JS}}

  function startGL() {
    import('three').then(function (THREE) {
      if (!THREE.WebGLRenderer) throw new Error('three');
      GL = makeGL(THREE); mode = 'gl';
      GL.go(current, true); GL.reveal();
      if (Q.qa) return;
      if (beat === 'hero' && !moment) autoplay(700);
    }).catch(function () { mode = 'poster'; if (beat === 'hero' && !Q.qa) autoplay(700); });
  }

  /* ---------------- boot: first paint is the H1 + poster; then scroll, then WebGL on idle ---------------- */
  var idle = 'requestIdleCallback' in window ? function (cb) { window.requestIdleCallback(cb, { timeout: 1200 }); } : function (cb) { setTimeout(cb, 200); };
  initScroll();
  if (Q.qa) {   // design review: jump to a state (after the pin spacer exists, so positions are final)
    var m = /^layer-(\d)$/.exec(Q.qa);
    if (m && hsST) window.scrollTo(0, Math.min(hsST.end - 2, hsST.start + (hsST.end - hsST.start) * (+m[1]) / (cards.length - 1) + 1));
    else if (m) { hs.scrollIntoView(); hsGoTo(+m[1]); }
    else { var qaEl = document.querySelector('[data-beat="' + Q.qa + '"]'); if (qaEl && Q.qa !== 'hero') window.scrollTo(0, qaEl.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.3); }
    if (SEQ.indexOf(Q.qa) >= 0) { setMoment(Q.qa); show(Q.qa, true); }
    if (window.ScrollTrigger) ScrollTrigger.update();
  }
  window.addEventListener('resize', function () { measure(); if (GL) GL.resize(); else posterShow(current, true); }, { passive: true });
  window.addEventListener('pointermove', function (e) { if (GL && mqFine.matches) GL.pointer(e.clientX, e.clientY); }, { passive: true });
  document.documentElement.addEventListener('pointerleave', function () { if (GL) GL.pointerOut(); });
  requestAnimationFrame(function () { idle(function () { if (wantGL()) startGL(); else if (beat === 'hero' && !Q.qa) autoplay(700); }); });
});
</script>
</body>
</html>
