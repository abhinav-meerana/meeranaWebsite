      <ol class="tl" aria-hidden="true"><span class="tl-fill"></span>
        <li data-tl="1"><span>01</span>Problem</li><li data-tl="2"><span>02</span>AI detects</li><li data-tl="3"><span>03</span>Automation acts</li>
        <li data-tl="4"><span>04</span>Dashboard shows</li><li data-tl="5"><span>05</span>Business outcome</li>
      </ol>
      <ol class="steps" data-audit-ok="G05" aria-label="A sample scenario in five steps">
        <li class="beat step" data-beat="story-1"><div class="col surface card w-full">
          <div class="step-no"><span class="eyebrow">Problem</span><span class="num" aria-hidden="true">01</span></div>
          <h3 class="mt-4 text-heading-1 font-normal text-fg">Smoke in a storage bay, after hours.</h3>
          <p class="mt-3 text-body text-fg-secondary">Nobody is watching that camera feed.</p></div></li>
        <li class="beat step" data-beat="story-2"><div class="col surface card w-full">
          <div class="step-no"><span class="eyebrow">AI detects</span><span class="num" aria-hidden="true">02</span></div>
          <h3 class="mt-4 text-heading-1 font-normal text-fg" data-ev="EV-138 EV-444">Yisbir flags smoke on the existing camera.</h3>
          <p class="sample" data-illustrative><span class="tag">Sample</span>Smoke · confidence 0.94 · CAM-07 · Bay 3 · 02:14:09</p></div></li>
        <li class="beat step" data-beat="story-3"><div class="col surface card w-full">
          <div class="step-no"><span class="eyebrow">Automation acts</span><span class="num" aria-hidden="true">03</span></div>
          <h3 class="mt-4 text-heading-1 font-normal text-fg" data-ev="EV-138 EV-534">The duty team gets the alert, the clip and a task.</h3>
          <p class="sample" data-illustrative><span class="tag">Sample</span>Alert → duty officer · clip 00:30 · task R-0142 opened</p></div></li>
        <li class="beat step" data-beat="story-4"><div class="col surface card w-full">
