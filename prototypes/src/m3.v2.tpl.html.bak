<svg class="m3p m3p-probe" width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <polygon class="ft t0"/><polygon class="ft t1"/><polygon class="ft t2"/><polygon class="ft t3"/><polygon class="ft t4"/><polygon class="ft t5"/>
