<!-- colour probes: the WebGL renderer reads tone colours from these, so hex values stay in tokens.css -->
<svg class="m3p m3p-probe" width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <polygon class="ft t0"/><polygon class="ft t1"/><polygon class="ft t2"/><polygon class="ft t3"/><polygon class="ft t4"/><polygon class="ft t5"/>
  <polygon class="ft t6"/><polygon class="ft t7"/><polygon class="ft t8"/><polygon class="ft t9"/><polygon class="ft t10"/><polygon class="ft t11"/>
</svg>

<script>
{{M3_SCENE_JS}}
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  'use strict';
  var S = window.M3Scene, FM = S.formations, R = S.R, U = S.U;
  var root = document.documentElement, body = document.body;
  var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var mqFine = window.matchMedia('(pointer: fine)');
  function isReduced() { return mqReduce.matches || root.dataset.motion === 'reduce'; }
  // QA hooks for design review screenshots: #qa=<beat>&webgl=force|off&t=<seconds> renders that state, settled.
  var Q = {}; location.hash.replace(/^#/, '').split('&').forEach(function (kv) { var p = kv.split('='); if (p[0]) Q[p[0]] = p.length > 1 ? decodeURIComponent(p[1]) : '1'; });

  var stage = document.getElementById('stage'), posters = stage.querySelector('.posters'), canvas = stage.querySelector('canvas');
  var probes = { main: stage.querySelector('.rect-main.probe') };
  var vw = 0, vh = 0, rects = {};
  function measure() {   // cached on resize only: never read layout inside the animation loop
    vw = window.innerWidth; vh = window.innerHeight;
    for (var k in probes) { var r = probes[k].getBoundingClientRect(); rects[k] = { x: r.left, y: r.top, w: r.width, h: r.height }; }
  }
  measure();
  function framing(f) { var b = f.box, r = rects[f.rect], s = Math.min(r.w / b.w, r.h / b.h);
    return { s: s, cx: b.cx, cy: b.cy, px: r.x + r.w / 2, py: r.y + r.h / 2 }; }

  /* ---------------- overlays (DOM chips pinned to scene anchors) ---------------- */
  var ovls = Array.prototype.map.call(stage.querySelectorAll('[data-ovl]'), function (el) {
    return { el: el, f: el.dataset.ovl.split(' '), a: el.dataset.anchor, on: false }; });
  function overlaysFor(name, on) {
    ovls.forEach(function (o) { var v = on && o.f.indexOf(name) >= 0 && !!FM[name].anchors[o.a]; o.on = v; o.el.classList.toggle('is-on', v); }); }
  var ovlEl = stage.querySelector('.ovl'), lastS = 0;
  function placeOverlays(name, project, s) {
    var f = FM[name]; if (!f) return;
    if (s && Math.abs(s - lastS) > 0.25) { lastS = s; ovlEl.style.setProperty('--s', s.toFixed(2)); }
    ovls.forEach(function (o) { if (!o.on) return; var xy = project(f.anchors[o.a]);
      o.el.style.transform = 'translate3d(' + xy[0].toFixed(1) + 'px,' + xy[1].toFixed(1) + 'px,0)'; });
  }
  function posterProject(f) { var fr = framing(f);
    var fn = function (p) { return [fr.px + (S.dot(p, R) - fr.cx) * fr.s, fr.py - (S.dot(p, U) - fr.cy) * fr.s]; }; fn.s = fr.s; return fn; }

  /* ---------------- poster mode (no WebGL, small screens): same shapes as SVG, cross-faded ---------------- */
  var mode = 'poster', current = 'hero', GL = null;
  function posterShow(name, instant) {
    var f = FM[name], olds = posters.querySelectorAll('.m3p');
    if (olds.length === 1 && olds[0].dataset.f === name) { overlaysFor(name, true); var pp = posterProject(f); placeOverlays(name, pp, pp.s); return; }
    var tmp = document.createElement('div'); tmp.innerHTML = S.poster(f, 'rect-' + f.rect);
    var svg = tmp.firstChild; posters.appendChild(svg); overlaysFor(name, false);
    function swap() { svg.classList.add('is-on'); olds.forEach(function (o) { o.classList.remove('is-on'); setTimeout(function () { o.remove(); }, instant ? 0 : 260); });
      overlaysFor(name, true); var pp = posterProject(f); placeOverlays(name, pp, pp.s); }
    if (instant || isReduced()) swap(); else requestAnimationFrame(function () { requestAnimationFrame(swap); });
  }
  function show(name, instant) { if (!FM[name]) return; current = name; if (mode === 'gl') GL.go(name, instant); else posterShow(name, instant); }

  /* ---------------- beats → scene states; chapter + sequence UI ---------------- */
  var BEATS = { hero: 'hero', layer: 'layerAll', world: 'world', 'story-0': 'bay1', 'story-1': 'bay1', 'story-2': 'bay2', 'story-3': 'bay3',
                'story-4': 'bars', 'story-5': 'bay5', next: 'next' };
  for (var li = 0; li < 6; li++) BEATS['layer-' + li] = 'layer' + li;
  var beatEls = Array.prototype.slice.call(document.querySelectorAll('[data-beat]'));
  var chNo = document.querySelector('[data-ch-no]'), chName = document.querySelector('[data-ch-name]');
  var beat = null, moment = null;
  function setBeat(b) {
    if (b === beat) return;
    beat = b; body.dataset.scene = b;
    if (b !== 'hero') { stopAutoplay(); setMoment(null); }
    show(b === 'hero' && moment ? moment : BEATS[b]);
    var el = document.querySelector('[data-beat="' + b + '"]'), ch = el && el.closest('.chapter');
    if (ch) { chNo.textContent = ch.dataset.chapter; chName.textContent = ch.dataset.chapterName; }
    document.querySelectorAll('[data-seq]').forEach(function (s) { if (s.dataset.seq === b) s.setAttribute('aria-current', 'step'); else s.removeAttribute('aria-current'); });
    beatEls.forEach(function (e) { if (e.dataset.beat === b) e.setAttribute('data-active', ''); else e.removeAttribute('data-active'); });
  }

  /* ---------------- hero: four rapid moments (autoplay once, then on demand) ---------------- */
  var SEQ = ['ai', 'auto', 'iot', 'sec'], HOLD = 1500, apTimer = 0, apIdx = -1;
  var momentBtns = Array.prototype.slice.call(document.querySelectorAll('[data-moment]'));
  function setMoment(m) {
    moment = m; momentBtns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.moment === m)); });
  }
  function stopAutoplay() { clearTimeout(apTimer); apIdx = -1; }
  function stepAutoplay() {
    if (beat !== 'hero' || isReduced()) { stopAutoplay(); return; }
    if (apIdx < SEQ.length) { setMoment(SEQ[apIdx]); show(SEQ[apIdx]); apIdx++; apTimer = setTimeout(stepAutoplay, HOLD); }
    else { setMoment(null); show('hero'); apIdx = -1; }
  }
  function autoplay(delay) { stopAutoplay(); if (isReduced() || beat !== 'hero' || Q.qa) return; apIdx = 0; apTimer = setTimeout(stepAutoplay, delay || 0); }
  momentBtns.forEach(function (b, i) {
    b.addEventListener('click', function () { stopAutoplay(); var m = b.dataset.moment;
      if (moment === m) { setMoment(null); show('hero'); } else { setMoment(m); show(m); } });
    // micro-interaction: hovering or focusing a moment brightens its input stream into the core
    function hi(on) { if (GL) GL.stream(on ? i + 1 : 0); }
    b.addEventListener('mouseenter', function () { hi(true); }); b.addEventListener('mouseleave', function () { hi(false); });
    b.addEventListener('focus', function () { hi(true); }); b.addEventListener('blur', function () { hi(false); });
  });
  document.querySelector('[data-replay]').addEventListener('click', function () { setMoment(null); show('hero'); autoplay(500); });

  /* ---------------- Pause motion (WCAG 2.2.2) = on-page reduced motion, persisted ---------------- */
  var toggle = document.querySelector('[data-motion-toggle]');
  function syncToggle() { toggle.setAttribute('aria-pressed', String(isReduced())); }   /* label stays constant; aria-pressed carries the state */
  toggle.addEventListener('click', function () {
    if (root.dataset.motion === 'reduce') { delete root.dataset.motion; try { localStorage.removeItem('meerana-motion'); } catch (e) {} }
    else { root.dataset.motion = 'reduce'; try { localStorage.setItem('meerana-motion', 'reduce'); } catch (e) {} stopAutoplay(); }
    syncToggle(); if (GL) GL.kick();
  });
  mqReduce.addEventListener('change', function () { syncToggle(); stopAutoplay(); if (GL) GL.kick(); });
  syncToggle();

  /* ---------------- scroll: GSAP ScrollTrigger is the single owner (IntersectionObserver if the CDN fails) ---------------- */
  var bar = document.querySelector('.progress');
  function initScroll() {
    if (window.gsap && window.ScrollTrigger) {
      gsap.registerPlugin(ScrollTrigger);
      beatEls.forEach(function (el) {
        ScrollTrigger.create({ trigger: el, start: 'top 58%', end: 'bottom 58%', onToggle: function (st) { if (st.isActive) setBeat(el.dataset.beat); } });
      });
      ScrollTrigger.create({ start: 0, end: 'max', onUpdate: function (st) { bar.style.transform = 'scaleX(' + st.progress.toFixed(4) + ')'; } });
      ['#layer', '#story', '#contact'].forEach(function (sel) {   // scrubbed: the scene turns a few degrees as the chapter scrolls
        ScrollTrigger.create({ trigger: sel, start: 'top bottom', end: 'bottom top', onUpdate: function (st) { if (GL) GL.drift(st.progress - 0.5); } });
      });
      if (document.fonts) document.fonts.ready.then(function () { ScrollTrigger.refresh(); });
    } else if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) setBeat(e.target.dataset.beat); }); }, { rootMargin: '-42% 0px -42% 0px' });
      beatEls.forEach(function (el) { io.observe(el); });
    }
    if (!beat) setBeat('hero');
  }

  /* ---------------- WebGL ---------------- */
  function rgb(s) { var m = String(s).match(/[\d.]+/g); return m && m.length >= 3 ? [m[0] / 255, m[1] / 255, m[2] / 255] : [1, 1, 1]; }
  function readPalette() {
    var top = [], edge = [], ea = [], probe = document.querySelector('.m3p-probe');
    for (var k = 0; k < 12; k++) { var cs = getComputedStyle(probe.querySelector('.t' + k));
      top[k] = rgb(cs.fill); edge[k] = rgb(cs.stroke); ea[k] = parseFloat(cs.strokeOpacity) || 0; }
    return { top: top, edge: edge, ea: ea, bg: rgb(getComputedStyle(body).backgroundColor) };
  }
  function wantGL() {
    if (Q.webgl === 'off') return false;
    if (Q.webgl === 'force') return true;
    if (vw < 768) return false;                              // posters on small screens (battery, LCP)
    try { var c = document.createElement('canvas'), g = c.getContext('webgl2', { failIfMajorPerformanceCaveat: true });
      if (!g) return false; var x = g.getExtension('WEBGL_lose_context'); if (x) x.loseContext(); return true; } catch (e) { return false; }
  }

  var VS = [
    'attribute vec3 aTop; attribute vec4 aEdge;',
    'uniform vec3 uCenter; uniform float uSpan;',
    'varying vec2 vUv; varying float vShade; varying vec3 vTop; varying vec4 vEdge; varying float vFog;',
    'void main() {',
    '  vUv = uv; vTop = aTop; vEdge = aEdge;',
    '  vShade = normal.y > 0.5 ? 1.0 : (normal.x > 0.5 ? 0.66 : (normal.z > 0.5 ? 0.46 : 0.3));',
    '  vec4 wp = modelMatrix * instanceMatrix * vec4(position, 1.0);',
    '  vFog = clamp(0.42 - dot(wp.xyz - uCenter, vec3(0.57735)) / uSpan, 0.0, 0.62);',
    '  gl_Position = projectionMatrix * viewMatrix * wp;',
    '}'].join('\n');
  var FS = [
    'uniform vec3 uBg;',
    'varying vec2 vUv; varying float vShade; varying vec3 vTop; varying vec4 vEdge; varying float vFog;',
    'void main() {',
    '  vec2 w = fwidth(vUv) * 1.15;',
    '  vec2 a = smoothstep(vec2(0.0), w, vUv) * smoothstep(vec2(0.0), w, 1.0 - vUv);',
    '  float e = 1.0 - min(a.x, a.y);',
    '  vec3 col = mix(vTop * vShade, vEdge.rgb, e * vEdge.a);',
    '  gl_FragColor = vec4(mix(col, uBg, vFog), 1.0);',
    '}'].join('\n');
  var LVS = [
    'attribute float aT; attribute vec4 aCol; attribute float aFlow; attribute float aGrp;',
    'uniform float uGrp;',
    'varying float vT; varying vec4 vCol; varying float vFlow; varying float vHi; varying float vDim;',
    'void main() {',
    '  vT = aT; vCol = aCol; vFlow = aFlow;',
    '  vHi = (uGrp > 0.5 && abs(aGrp - uGrp) < 0.5) ? 1.0 : 0.0;',
    '  vDim = (uGrp > 0.5 && aGrp > 0.5 && vHi < 0.5) ? 0.4 : 1.0;',
    '  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);',
    '}'].join('\n');
  var LFS = [
    'uniform float uTime; uniform float uOpacity;',
    'varying float vT; varying vec4 vCol; varying float vFlow; varying float vHi; varying float vDim;',
    'void main() {',
    '  float p = fract(vT * 2.0 - uTime * 0.32);',
    '  float pulse = smoothstep(0.0, 0.05, p) * (1.0 - smoothstep(0.05, 0.22, p));',
    '  float a = vCol.a * (0.55 + vFlow * 1.7 * pulse) * (1.0 + vHi * 1.3) * vDim;',
    '  gl_FragColor = vec4(vCol.rgb, min(a, 1.0) * uOpacity);',
    '}'].join('\n');

  function makeGL(THREE) {
    var pal = readPalette(), N = S.N;
    var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setClearColor(0x000000, 0);
    var scene = new THREE.Scene(), cam = new THREE.OrthographicCamera(-1, 1, 1, -1, 20, 240);
    cam.position.set(70, 70, 70); cam.lookAt(0, 0, 0); cam.updateMatrixWorld();
    var pivotG = new THREE.Group(), inner = new THREE.Group(); pivotG.add(inner); scene.add(pivotG);

    var geo = new THREE.BoxGeometry(1, 1, 1);
    var aTop = new THREE.InstancedBufferAttribute(new Float32Array(N * 3), 3), aEdge = new THREE.InstancedBufferAttribute(new Float32Array(N * 4), 4);
    aTop.setUsage(THREE.DynamicDrawUsage); aEdge.setUsage(THREE.DynamicDrawUsage);
    geo.setAttribute('aTop', aTop); geo.setAttribute('aEdge', aEdge);
    var mat = new THREE.ShaderMaterial({ vertexShader: VS, fragmentShader: FS, uniforms: {
      uBg: { value: new THREE.Vector3(pal.bg[0], pal.bg[1], pal.bg[2]) }, uCenter: { value: new THREE.Vector3() }, uSpan: { value: 10 } } });
    var mesh = new THREE.InstancedMesh(geo, mat, N); mesh.frustumCulled = false; mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage); inner.add(mesh);
    var M = mesh.instanceMatrix.array;

    // flow lines: one LineSegments per formation and depth mode; faded in when their formation settles
    var lineSets = {};
    Object.keys(FM).forEach(function (name) {
      var f = FM[name]; if (!f.lines.length) return;
      [true, false].forEach(function (depth) {
        var P = [], Tt = [], Cc = [], Fl = [], Gr = [];
        f.lines.forEach(function (l) {
          if (l.depth !== depth) return;
          var n = l.pts.length, c = pal.edge[l.t], a = l.a * pal.ea[l.t];
          for (var i = 0; i < n - 1; i++) { var A = l.pts[i], B = l.pts[i + 1];
            P.push(A[0], A[1], A[2], B[0], B[1], B[2]); Tt.push(i / (n - 1), (i + 1) / (n - 1));
            Cc.push(c[0], c[1], c[2], a, c[0], c[1], c[2], a); Fl.push(l.flow ? 1 : 0, l.flow ? 1 : 0); Gr.push(l.g, l.g); }
        });
        if (!P.length) return;
        var g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.Float32BufferAttribute(P, 3)); g.setAttribute('aT', new THREE.Float32BufferAttribute(Tt, 1));
        g.setAttribute('aCol', new THREE.Float32BufferAttribute(Cc, 4)); g.setAttribute('aFlow', new THREE.Float32BufferAttribute(Fl, 1));
        g.setAttribute('aGrp', new THREE.Float32BufferAttribute(Gr, 1));
        var m = new THREE.ShaderMaterial({ vertexShader: LVS, fragmentShader: LFS, transparent: true, depthWrite: false, depthTest: depth,
          uniforms: { uTime: { value: 0 }, uOpacity: { value: 0 }, uGrp: { value: 0 } } });
        var obj = new THREE.LineSegments(g, m); obj.frustumCulled = false; obj.visible = false; obj.renderOrder = depth ? 1 : 2; inner.add(obj);
        (lineSets[name] = lineSets[name] || []).push({ obj: obj, mat: m, op: 0 });
      });
    });

    // per-instance state: current, from (captured at each change), delays
    function st() { return { pos: new Float32Array(N * 3), scl: new Float32Array(N * 3), top: new Float32Array(N * 3), edge: new Float32Array(N * 4) }; }
    var cur = st(), from = st(), delay = new Float32Array(N), lift = new Float32Array(N), liftT = new Float32Array(N);
    var target = null, t0 = 0, dur = 0, frFrom = null, frTo = null, pivFrom = [0, 0, 0], pivTo = [0, 0, 0], pivCur = [0, 0, 0], frCur = null;
    var time = Number(Q.t) || 0, last = 0, raf = 0, grp = 0, settledShown = false;
    var rot = { x: 0, y: 0 }, rotT = { x: 0, y: 0 }, drift = 0, driftT = 0, pointer = null;
    var tmpTop = [0, 0, 0], tmpEdge = [0, 0, 0, 0], tmpPos = [0, 0, 0], tmpScl = [0, 0, 0];

    function ease(x) { x = x < 0 ? 0 : x > 1 ? 1 : x; return 1 - Math.pow(1 - x, 3.2); }   // ≈ cubic-bezier(0.2, 0, 0, 1) (--ease-standard)
    function colorOf(f, c, top, edge) {
      var keep = c.t === S.T.accent || c.t === S.T.danger || c.t === S.T.smoke, d = keep ? 1 : f.dim, et = c.e !== undefined ? c.e : c.t;
      var tp = pal.top[c.t], ec = pal.edge[et], ed = keep ? 1 : 0.55 + 0.45 * d;
      top[0] = tp[0] * d; top[1] = tp[1] * d; top[2] = tp[2] * d;
      edge[0] = ec[0] * ed; edge[1] = ec[1] * ed; edge[2] = ec[2] * ed; edge[3] = pal.ea[et] * (c.ea !== undefined ? c.ea : 1);
    }
    // live target for a cell (its rest position plus the formation's ambient motion at the current time)
    function live(f, c, i, pos, scl, top, edge) {
      pos[0] = c.p[0]; pos[1] = c.p[1]; pos[2] = c.p[2]; scl[0] = c.s[0]; scl[1] = c.s[1]; scl[2] = c.s[2];
      colorOf(f, c, top, edge);
      if (f.anim === 'breathe') {
        var L = Math.hypot(pos[0], pos[1], pos[2]) || 1, w = 0.09 * Math.sin(time * 1.15 - L * 0.55) + lift[i];
        pos[0] += pos[0] / L * w; pos[1] += pos[1] / L * w; pos[2] += pos[2] / L * w;
        if (lift[i] > 0.01) { var k = Math.min(1, lift[i] * 2); edge[3] = Math.min(1, edge[3] + 0.6 * k); edge[0] += (1 - edge[0]) * k * 0.5; edge[1] += (1 - edge[1]) * k * 0.5; edge[2] += (1 - edge[2]) * k * 0.5; }
      } else if (f.anim === 'smoke' && c.g === 'smoke') {
        var fr = (c.ph + time * 0.11) % 1;
        pos[0] = c.p[0] + (fr - c.ph) * 0.7; pos[1] = 2.7 + fr * 3.4; var z = c.sz * (1 - 0.5 * fr) * Math.min(1, (1 - fr) * 6);
        scl[0] = scl[1] = scl[2] = z;
      } else if (f.anim === 'token' && c.g === 'token') {
        var path = f.path, u = (time * 0.16) % 1 * (path.length - 1), j = Math.floor(u), q = u - j, A = path[j], B = path[Math.min(j + 1, path.length - 1)];
        pos[0] = A[0] + (B[0] - A[0]) * q; pos[1] = A[1] + (B[1] - A[1]) * q + 0.25; pos[2] = A[2] + (B[2] - A[2]) * q;
      } else if (f.anim === 'scan' && c.g === 'text') {
        var sz = (time * 0.32) % 1 * 10 - 1, h = Math.exp(-Math.pow(c.row - sz, 2) / 0.7);
        top[0] += (1 - top[0]) * 0.3 * h; top[1] += (1 - top[1]) * 0.3 * h; top[2] += (1 - top[2]) * 0.3 * h; edge[3] = Math.min(1, edge[3] + 0.5 * h);
      } else if (f.anim === 'wave' && c.d !== undefined) {
        pos[1] += 0.34 * Math.sin(c.d * 0.8 - time * 1.1) * Math.max(0, 1 - c.d / 11);
      }
    }
    function lerpFrame(a, b, t) { return { s: Math.exp(Math.log(a.s) + (Math.log(b.s) - Math.log(a.s)) * t), cx: a.cx + (b.cx - a.cx) * t, cy: a.cy + (b.cy - a.cy) * t,
      px: a.px + (b.px - a.px) * t, py: a.py + (b.py - a.py) * t }; }

    function go(name, instant) {
      var f = FM[name], now = performance.now();
      var animate = !instant && !isReduced() && target !== null;
      from.pos.set(cur.pos); from.scl.set(cur.scl); from.top.set(cur.top); from.edge.set(cur.edge);
      var b = f.box, maxD = 0;
      for (var i = 0; i < N; i++) {
        var c = f.cells[i], X, Y;
        if (c && c.s[0] > 0) {
          if (from.scl[i * 3] === 0) {   // appears: grow in place, starting in its own colours
            live(f, c, i, tmpPos, tmpScl, tmpTop, tmpEdge);
            from.pos.set(tmpPos, i * 3); from.top.set(tmpTop, i * 3); from.edge.set(tmpEdge, i * 4);
          }
          X = S.dot(c.p, R); Y = S.dot(c.p, U);
          delay[i] = f.sweep === 'radial' ? Math.hypot(c.p[0], c.p[2]) : ((X - b.x0) / b.w) * 0.6 + ((b.y1 - Y) / b.h) * 0.4;
        } else {
          var p = [from.pos[i * 3], from.pos[i * 3 + 1], from.pos[i * 3 + 2]];
          X = S.dot(p, R); Y = S.dot(p, U);
          delay[i] = f.sweep === 'radial' ? Math.hypot(p[0], p[2]) : ((X - b.x0) / b.w) * 0.6 + ((b.y1 - Y) / b.h) * 0.4;
        }
        if (delay[i] > maxD) maxD = delay[i];
      }
      for (i = 0; i < N; i++) delay[i] = maxD > 0 ? Math.max(0, delay[i] / maxD) * 480 : 0;   // total stagger ≤ 480 ms
      frFrom = frCur || framing(f); frTo = framing(f);
      pivFrom = pivCur.slice(); pivTo = b.pivot.slice(); if (!target) pivFrom = pivTo.slice();
      target = f; t0 = now; dur = animate ? 1 : 0; settledShown = false;
      overlaysFor(f.name, false);
      kick();
    }

    function frame(now) {
      raf = 0;
      var dt = Math.min(0.05, (now - (last || now)) / 1000); last = now;
      var moving = !isReduced() && !document.hidden;
      if (moving) time += dt;
      var el = now - t0, morphing = false, f = target;
      for (var i = 0; i < N; i++) {
        var e = dur ? ease((el - delay[i]) / 420) : 1;   // one step = --dur-3 (420 ms) per cell
        if (e < 1) morphing = true;
        var c = f.cells[i], i3 = i * 3, i4 = i * 4;
        lift[i] += (liftT[i] - lift[i]) * Math.min(1, dt * 9);
        if (Math.abs(liftT[i] - lift[i]) > 0.002) morphing = true;
        if (c && c.s[0] > 0) live(f, c, i, tmpPos, tmpScl, tmpTop, tmpEdge);
        else { tmpPos[0] = from.pos[i3]; tmpPos[1] = from.pos[i3 + 1]; tmpPos[2] = from.pos[i3 + 2]; tmpScl[0] = tmpScl[1] = tmpScl[2] = 0;
          tmpTop[0] = from.top[i3]; tmpTop[1] = from.top[i3 + 1]; tmpTop[2] = from.top[i3 + 2];
          tmpEdge[0] = from.edge[i4]; tmpEdge[1] = from.edge[i4 + 1]; tmpEdge[2] = from.edge[i4 + 2]; tmpEdge[3] = from.edge[i4 + 3]; }
        for (var k = 0; k < 3; k++) {
          cur.pos[i3 + k] = from.pos[i3 + k] + (tmpPos[k] - from.pos[i3 + k]) * e;
          cur.scl[i3 + k] = from.scl[i3 + k] + (tmpScl[k] - from.scl[i3 + k]) * e;
          cur.top[i3 + k] = from.top[i3 + k] + (tmpTop[k] - from.top[i3 + k]) * e;
          cur.edge[i4 + k] = from.edge[i4 + k] + (tmpEdge[k] - from.edge[i4 + k]) * e;
        }
        cur.edge[i4 + 3] = from.edge[i4 + 3] + (tmpEdge[3] - from.edge[i4 + 3]) * e;
        var o = i * 16;   // translation + scale matrix, written directly (no allocation)
        M[o] = cur.scl[i3]; M[o + 1] = 0; M[o + 2] = 0; M[o + 3] = 0; M[o + 4] = 0; M[o + 5] = cur.scl[i3 + 1]; M[o + 6] = 0; M[o + 7] = 0;
        M[o + 8] = 0; M[o + 9] = 0; M[o + 10] = cur.scl[i3 + 2]; M[o + 11] = 0; M[o + 12] = cur.pos[i3]; M[o + 13] = cur.pos[i3 + 1]; M[o + 14] = cur.pos[i3 + 2]; M[o + 15] = 1;
      }
      aTop.array.set(cur.top); aEdge.array.set(cur.edge);
      mesh.instanceMatrix.needsUpdate = true; aTop.needsUpdate = true; aEdge.needsUpdate = true;

      var ge = dur ? ease(el / 900) : 1;
      frCur = lerpFrame(frFrom, frTo, ge);
      for (k = 0; k < 3; k++) pivCur[k] = pivFrom[k] + (pivTo[k] - pivFrom[k]) * ge;
      var l = frCur.cx - frCur.px / frCur.s, t = frCur.cy + frCur.py / frCur.s;
      cam.left = l; cam.right = l + vw / frCur.s; cam.top = t; cam.bottom = t - vh / frCur.s; cam.updateProjectionMatrix();
      mat.uniforms.uCenter.value.set(pivCur[0], pivCur[1], pivCur[2]); mat.uniforms.uSpan.value = Math.max(f.box.w, f.box.h) * 0.9;

      // rotation: ambient sway + scroll drift + pointer parallax, all smoothed (≤ 0.5 s)
      var k2 = Math.min(1, dt * 7);
      drift += (driftT - drift) * k2; rot.x += (rotT.x - rot.x) * k2; rot.y += (rotT.y - rot.y) * k2;
      var sway = f.anim === 'none' ? 0 : 0.05 * Math.sin(time * 0.21);
      pivotG.position.set(pivCur[0], pivCur[1], pivCur[2]); inner.position.set(-pivCur[0], -pivCur[1], -pivCur[2]);
      pivotG.rotation.set(rot.x, sway + drift + rot.y, 0, 'YXZ');
      var converging = Math.abs(driftT - drift) > 0.0005 || Math.abs(rotT.x - rot.x) > 0.0005 || Math.abs(rotT.y - rot.y) > 0.0005;

      // lines: the target formation's fade in once its cells have mostly arrived; all others fade out
      var lineAnim = false, kl = dur ? Math.min(1, dt * 5) : 1;
      Object.keys(lineSets).forEach(function (name) {
        var want = name === f.name && ge > 0.55 ? 1 : 0;
        lineSets[name].forEach(function (L) {
          L.op += (want - L.op) * (isReduced() ? 1 : kl); if (Math.abs(want - L.op) < 0.003) L.op = want; else lineAnim = true;
          L.obj.visible = L.op > 0.001; L.mat.uniforms.uOpacity.value = L.op; L.mat.uniforms.uTime.value = time; L.mat.uniforms.uGrp.value = grp;
        });
      });

      renderer.render(scene, cam);

      if (!settledShown && ge > 0.85) { settledShown = true; overlaysFor(f.name, true); }
      placeOverlays(f.name, project, frCur.s);

      var ambient = moving && (f.anim !== 'none' || (lineSets[f.name] && f.lines.some(function (q) { return q.flow; })));
      if (morphing || ge < 1 || converging || lineAnim || ambient) raf = requestAnimationFrame(frame);
    }
    var v3 = new THREE.Vector3();
    function project(p) { v3.set(p[0], p[1], p[2]).applyMatrix4(inner.matrixWorld).project(cam); return [(v3.x + 1) / 2 * vw, (1 - v3.y) / 2 * vh]; }
    function kick() { if (!raf && !document.hidden && target) { last = 0; raf = requestAnimationFrame(frame); } }

    function resize() {
      var dpr = Math.min(window.devicePixelRatio || 1, vw < 1024 ? 1.25 : 1.5);
      renderer.setPixelRatio(dpr); renderer.setSize(vw, vh, false);
      if (target) { frTo = framing(target); if (!dur || performance.now() - t0 > 900) { frFrom = frTo; frCur = frTo; } }
      kick();
    }
    resize();

    // micro-interaction: cells of the core near the pointer lift outward and brighten their edges
    var pending = false;
    function pointerAt(x, y) {
      if (isReduced()) { rotT.x = rotT.y = 0; return; }
      rotT.y = (x / vw - 0.5) * 0.09; rotT.x = (y / vh - 0.5) * 0.05; pointer = [x, y];
      if (!pending) { pending = true; requestAnimationFrame(function () { pending = false;
        var hero = target && target.name === 'hero';
        for (var i = 0; i < N; i++) {
          if (!hero || !pointer || !(cur.scl[i * 3] > 0)) { liftT[i] = 0; continue; }
          var xy = project([cur.pos[i * 3], cur.pos[i * 3 + 1], cur.pos[i * 3 + 2]]), d = Math.hypot(xy[0] - pointer[0], xy[1] - pointer[1]);
          liftT[i] = d < 150 ? 0.55 * (1 - d / 150) * (1 - d / 150) : 0;
        }
        kick(); }); }
      kick();
    }
    function pointerOut() { pointer = null; rotT.x = rotT.y = 0; for (var i = 0; i < N; i++) liftT[i] = 0; kick(); }

    canvas.addEventListener('webglcontextlost', function (e) { e.preventDefault(); cancelAnimationFrame(raf); raf = 0; GL = null; mode = 'poster';
      stage.classList.remove('is-gl'); posterShow(current, true); });
    document.addEventListener('visibilitychange', function () { if (document.hidden) { cancelAnimationFrame(raf); raf = 0; } else kick(); });

    return { go: go, kick: kick, resize: resize, pointer: pointerAt, pointerOut: pointerOut,
      drift: function (p) { driftT = isReduced() ? 0 : p * 0.16; kick(); },
      stream: function (g) { grp = g; kick(); },
      reveal: function () { requestAnimationFrame(function () { stage.classList.add('is-gl'); }); } };
  }

  function startGL() {
    import('three').then(function (THREE) {
      if (!THREE.WebGLRenderer) throw new Error('three');
      GL = makeGL(THREE); mode = 'gl';
      GL.go(current, true); GL.reveal();
      if (Q.qa) return;
      if (beat === 'hero' && !moment) autoplay(700);
    }).catch(function () { mode = 'poster'; if (beat === 'hero' && !Q.qa) autoplay(700); });
  }

  /* ---------------- boot: first paint is the H1 + poster; then scroll, then WebGL on idle ---------------- */
  var idle = 'requestIdleCallback' in window ? function (cb) { window.requestIdleCallback(cb, { timeout: 1200 }); } : function (cb) { setTimeout(cb, 200); };
  if (Q.qa) {
    var qaEl = document.querySelector('[data-beat="' + Q.qa + '"]');
    if (qaEl && Q.qa !== 'hero') window.scrollTo(0, qaEl.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.3);
    if (SEQ.indexOf(Q.qa) >= 0) { setMoment(Q.qa); moment = Q.qa; }
  }
  initScroll();
  if (Q.qa && SEQ.indexOf(Q.qa) >= 0) show(Q.qa, true);
  window.addEventListener('resize', function () { measure(); if (GL) GL.resize(); else posterShow(current, true); }, { passive: true });
  window.addEventListener('pointermove', function (e) { if (GL && mqFine.matches) GL.pointer(e.clientX, e.clientY); }, { passive: true });
  document.documentElement.addEventListener('pointerleave', function () { if (GL) GL.pointerOut(); });
  requestAnimationFrame(function () { idle(function () { if (wantGL()) startGL(); else if (beat === 'hero' && !Q.qa) autoplay(700); }); });
});
</script>
</body>
</html>
