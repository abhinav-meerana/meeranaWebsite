<!doctype html>
<html lang="en" dir="ltr" data-brand="meerana" data-surface="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Meerana · M3 Intelligent Ecosystem · homepage prototype</title>
<meta name="description" content="Design prototype M3 (Intelligent Ecosystem) for the Meerana Technologies homepage: one isometric 3D scene told through scroll. Internal exploration; copy proposed, sample data labelled.">
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  /* Critical paint before the Tailwind browser build compiles: page colour, font and the fixed stage only. */
  html { background: #051326; color: #FFFFFF; font-family: "Poppins", ui-sans-serif, system-ui, sans-serif; }
  .stage { position: fixed; inset: 0; pointer-events: none; }
  .posters .m3p { position: absolute; opacity: 0; }
  .posters .m3p.is-on { opacity: 1; }
</style>
<script>
  /* Motion preference before first paint: OS setting or the persisted on-page toggle. */
  (function () { var d = document.documentElement; d.classList.add('js-motion');
    try { if (localStorage.getItem('meerana-motion') === 'reduce') d.dataset.motion = 'reduce'; } catch (e) {} })();
</script>
<script type="importmap">{ "imports": { "three": "https://cdn.jsdelivr.net/npm/three@0.186.1/build/three.module.min.js" } }</script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/ScrollTrigger.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3"></script>
<style type="text/tailwindcss">
@import "tailwindcss";
{{TOKENS_CSS}}

/* ---------------- page components (prototype M3) ---------------- */
@layer components {
  .wrap { margin-inline: auto; max-width: 80rem; padding-inline: clamp(16px, 4vw, 48px); }
  .col { max-width: 34rem; }
  @media (min-width: 1024px) { .col { max-width: min(34rem, calc(50vw - 76px)); } }
  .skip { position: absolute; inset-inline-start: -9999px; z-index: 60; }
  .skip:focus { inset-inline-start: 16px; top: 16px; background: var(--action-primary-bg); color: var(--action-primary-fg); padding: 10px 14px; border-radius: var(--radius-control); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .eyebrow { font-family: var(--font-family-mono); font-size: var(--text-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); }
  .btn-primary { display: inline-flex; align-items: center; min-height: 48px; padding-inline: 22px; border-radius: var(--radius-control);
    background: var(--action-primary-bg); color: var(--action-primary-fg); font-weight: 500; font-size: var(--text-ui);
    transition: background-color var(--dur-1) var(--ease-standard); }
  .btn-primary:hover { background: var(--action-primary-hover); }
  .btn-outline { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 16px; border-radius: var(--radius-control);
    border: 1px solid var(--action-secondary-border); color: var(--action-secondary-fg); font-size: var(--text-ui); font-weight: 500;
    transition: background-color var(--dur-1) var(--ease-standard); }
  .btn-outline:hover { background: var(--surface-raised); }
  .link-arrow { display: inline-flex; align-items: center; gap: .45em; min-height: 44px; color: var(--text-link); font-weight: 500; font-size: var(--text-ui); }
  .link-arrow > span { transition: transform var(--dur-1) var(--ease-standard); }
  .link-arrow:hover > span { transform: translateX(3px); }
  .mono-btn { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 12px; border-radius: var(--radius-pill);
    border: 1px solid var(--border-control); color: var(--text-secondary); font-family: var(--font-family-mono); font-size: .75rem;
    letter-spacing: .04em; text-transform: uppercase; transition: color var(--dur-1) var(--ease-standard), background-color var(--dur-1) var(--ease-standard); }
  .mono-btn:hover { color: var(--text-primary); }
  .mono-btn[aria-pressed="true"] { background: var(--surface-raised); color: var(--text-primary); }

  /* header: opaque (no glass over the moving scene), with a 1 px reading-progress rule */
  .site-header { position: sticky; top: 0; z-index: 30; background: var(--surface-deep); border-bottom: 1px solid var(--border-subtle); }
  .progress { position: absolute; inset-inline: 0; bottom: -1px; height: 1px; background: var(--text-accent); transform-origin: 0 50%; transform: scaleX(0); }
  main, .site-footer { position: relative; z-index: 10; }

  /* ---- the stage: ONE fixed canvas behind the page; posters first, WebGL after first paint ---- */
  .stage { z-index: 0; --r-top: calc(72px + 4%); --r-bottom: 6%; --r-left: calc(50% - 20px); --r-right: 3%; }
  @media (max-width: 1023px) { .stage { --r-top: 80px; --r-bottom: 56%; --r-left: 5%; --r-right: 5%; } }
  .rect-main { position: absolute; left: var(--r-left); top: var(--r-top); width: calc(100% - var(--r-left) - var(--r-right)); height: calc(100% - var(--r-top) - var(--r-bottom)); }
  .probe { visibility: hidden; }
  .posters { transition: opacity var(--dur-2) var(--ease-standard); }
  .posters .m3p { transition: opacity var(--dur-2) var(--ease-standard); }
  .stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity var(--dur-2) var(--ease-standard); }
  .stage.is-gl canvas { opacity: 1; }
  .stage.is-gl .posters { opacity: 0; }

  /* scene palette: tones resolve to brand tokens; the WebGL renderer reads these same computed values */
  .m3p polygon { fill: var(--c); stroke: var(--e); stroke-opacity: var(--ea); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .m3p .fx { fill: color-mix(in srgb, var(--c) 66%, black); }
  .m3p .fz { fill: color-mix(in srgb, var(--c) 46%, black); }
  .m3p .ln { fill: none; stroke: var(--e); stroke-opacity: calc(var(--a) * var(--ea)); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .m3p .t0  { --c: var(--navy-800); --e: var(--meerana-cyan); --ea: .34; }
  .m3p .t1  { --c: var(--meerana-cyan); --e: var(--meerana-cyan); --ea: .95; }
  .m3p .t2  { --c: var(--meerana-neutral); --e: var(--meerana-white); --ea: .6; }
  .m3p .t3  { --c: var(--meerana-blue); --e: var(--meerana-cyan); --ea: .8; }
  .m3p .t4  { --c: var(--state-error-on-dark); --e: var(--state-error-on-dark); --ea: .95; }
  .m3p .t5  { --c: var(--navy-300); --e: var(--navy-150); --ea: .4; }
  .m3p .t6  { --c: var(--tasree3-orange); --e: var(--tasree3-orange); --ea: .95; }
  .m3p .t7  { --c: var(--wasel-copper); --e: var(--wasel-sand); --ea: .9; }
  .m3p .t8  { --c: var(--mandoobee-azure); --e: var(--mandoobee-azure); --ea: .95; }
  .m3p .t9  { --c: var(--yisbir-aqua); --e: var(--yisbir-aqua); --ea: .95; }
  .m3p .t10 { --c: var(--navy-900); --e: var(--meerana-cyan); --ea: .13; }
  .m3p .t11 { --c: var(--navy-900); --e: var(--state-error-on-dark); --ea: .8; }
  .m3p .e1 { --e: var(--meerana-cyan); } .m3p .e2 { --e: var(--meerana-white); } .m3p .e3 { --e: var(--meerana-blue); }
  .m3p .e6 { --e: var(--tasree3-orange); } .m3p .e8 { --e: var(--mandoobee-azure); } .m3p .e9 { --e: var(--yisbir-aqua); }
  .m3p .ea { --ea: .5; }
  @media (prefers-reduced-motion: no-preference) {
    html:not([data-motion="reduce"]) .m3p .ln.fl { stroke-dasharray: 3 9; animation: m3-flow 1.6s linear infinite; }
  }
  @keyframes m3-flow { to { stroke-dashoffset: -24; } }

  /* overlays: DOM chips pinned to scene anchors (aria-hidden duplicates of the step text) */
  .ovl { position: absolute; inset: 0; }
  .ovl [data-ovl] { position: absolute; left: 0; top: 0; opacity: 0; transition: opacity var(--dur-2) var(--ease-standard); }
  .ovl [data-ovl].is-on { opacity: 1; }
  .chip { position: absolute; left: 0; top: 0; display: inline-flex; align-items: center; gap: .55em; transform: translate(calc(var(--bw, 0) * var(--s, 40) * .5px + 12px), -50%);
    white-space: nowrap; padding: 5px 9px; border-radius: var(--radius-control); background: var(--surface-raised); border: 1px solid var(--border-subtle);
    font-family: var(--font-family-mono); font-size: .6875rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-primary); }
  .chip.left { transform: translate(calc(-100% - 18px), -50%); }
  .chip i { width: 6px; height: 6px; border-radius: var(--radius-pill); background: var(--text-accent); }
  .chip.danger i { background: var(--state-danger); }
  .chip b { font-weight: 500; color: var(--text-accent); }
  .bracket { position: absolute; left: 0; top: 0; width: calc(var(--bw, 2) * var(--s, 40) * 1px); height: calc(var(--bh, 2.4) * var(--s, 40) * 1px); transform: translate(-50%, -50%) scale(1.25); opacity: 0;
    transition: transform var(--dur-1) var(--ease-enter), opacity var(--dur-1) var(--ease-enter); }
  [data-ovl].is-on .bracket { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  .bracket span { position: absolute; width: 14px; height: 14px; border-color: var(--text-accent); border-style: solid; border-width: 0; }
  .bracket span:nth-child(1) { left: 0; top: 0; border-left-width: 2px; border-top-width: 2px; }
  .bracket span:nth-child(2) { right: 0; top: 0; border-right-width: 2px; border-top-width: 2px; }
  .bracket span:nth-child(3) { left: 0; bottom: 0; border-left-width: 2px; border-bottom-width: 2px; }
  .bracket span:nth-child(4) { right: 0; bottom: 0; border-right-width: 2px; border-bottom-width: 2px; }
  .stage-note { position: absolute; inset-inline-end: 3%; bottom: 3%; opacity: 0; transition: opacity var(--dur-2) var(--ease-standard); }
  body[data-scene^="story"] .stage-note { opacity: 1; }
  @media (max-width: 1023px) { .stage-note { bottom: auto; top: calc(44% + 4px); } }

  /* ---- beats: each block maps to one scene state; text never moves while it is read ---- */
  .beat { position: relative; display: flex; align-items: center; min-height: 100vh; }
  .beat-item { min-height: 64vh; }
  .step { min-height: 86vh; }
  @media (max-width: 1023px) {
    .beat, .beat-item, .step { align-items: flex-start; min-height: 100svh; padding-top: 46svh; padding-bottom: 6svh; }
    .beat-hero { padding-top: 45svh; min-height: 0; }
    .card-m { background: var(--surface-raised); border: 1px solid var(--border-subtle); border-radius: var(--radius-card); padding: 20px; }
  }

  /* hero: four rapid moments (AI → Automation → IoT → Security) as real buttons */
  .moments { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--border-subtle); }
  @media (max-width: 639px) { .moments { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .moment { position: relative; display: flex; flex-direction: column; align-items: flex-start; width: 100%; min-height: 104px; padding: 16px 14px 14px 0;
    text-align: start; color: var(--text-secondary); }
  .moment::before { content: ""; position: absolute; inset-inline: 0 14px; top: -1px; height: 2px; background: var(--text-accent);
    transform: scaleX(0); transform-origin: 0 50%; transition: transform var(--dur-3) var(--ease-standard); }
  .moment[aria-pressed="true"]::before { transform: scaleX(1); }
  .moment .m-no { font-family: var(--font-family-mono); font-size: var(--text-mono); letter-spacing: .04em; color: var(--text-muted); }
  .moment .m-name { margin-top: 6px; font-size: var(--text-heading-3); line-height: 1.2; font-weight: 500; color: var(--text-primary); }
  .moment .m-prod { margin-top: 4px; font-size: var(--text-ui); color: var(--text-accent); }
  .moment .m-cap { margin-top: 2px; font-size: .8125rem; line-height: 1.35; color: var(--text-muted); transition: color var(--dur-1) var(--ease-standard); }
  .moment:hover .m-cap, .moment[aria-pressed="true"] .m-cap { color: var(--text-secondary); }
  .moment .m-arrow { position: absolute; inset-inline-end: 4px; top: 14px; color: var(--text-muted); font-size: var(--text-ui); }

  /* sticky sequence lines (layer and story): the reviewer's arrow chains, live */
  .seq-wrap { position: sticky; top: 72px; z-index: 2; }
  @media (max-width: 1023px) { .seq-wrap { position: static; } }
  .seq { display: flex; flex-wrap: wrap; gap: 4px 10px; padding-block: 14px; background: var(--surface-deep);
    border-bottom: 1px solid var(--border-subtle); font-family: var(--font-family-mono); font-size: var(--text-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); }
  .seq li { display: inline-flex; gap: 10px; transition: color var(--dur-1) var(--ease-standard); }
  .seq li + li::before { content: "→"; color: var(--border-control); }
  .seq li[aria-current] { color: var(--text-primary); }
  .seq li[aria-current] span { color: var(--text-accent); }

  .layers > li { border-inline-start: 0; }
  .lname { display: flex; align-items: baseline; gap: 16px; }
  .lrule { display: block; width: 48px; height: 2px; margin-top: 18px; background: var(--product-accent); transform: scaleX(.4); transform-origin: 0 50%;
    transition: transform var(--dur-3) var(--ease-standard); }
  .beat-item[data-active] .lrule { transform: scaleX(1); }
  .acc-blue { --product-accent: var(--meerana-blue); } .acc-neutral { --product-accent: var(--meerana-neutral); }

  .offices { display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .offices li { display: inline-flex; align-items: center; gap: 8px; }
  .offices li::before { content: ""; width: 6px; height: 6px; border-radius: var(--radius-pill); background: var(--text-secondary); }
  .offices li:first-child::before { background: var(--text-accent); }

  .sample { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 18px; font-family: var(--font-family-mono); font-size: var(--text-mono);
    letter-spacing: .04em; text-transform: uppercase; color: var(--text-secondary); }
  .tag { display: inline-flex; align-items: center; min-height: 22px; padding-inline: 8px; border-radius: var(--radius-pill); border: 1px solid var(--border-control);
    font-family: var(--font-family-mono); font-size: .6875rem; letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); }

  /* dashboard card: real DOM UI with sample data; the 3D bars beside it draw the same numbers */
  .dash { margin-top: 24px; background: var(--surface-raised); border: 1px solid var(--border-subtle); border-radius: var(--radius-card); padding: 18px 18px 14px; }
  .dash-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
  .dash table { width: 100%; margin-top: 14px; border-collapse: collapse; font-size: var(--text-ui); }
  .dash th { padding: 6px 4px; text-align: start; font-weight: 400; font-family: var(--font-family-mono); font-size: .6875rem; letter-spacing: .04em; color: var(--text-muted); }
  .dash tbody th { font-family: var(--font-family-sans); font-size: var(--text-ui); letter-spacing: 0; color: var(--text-secondary); }
  .dash td, .dash tbody th { padding: 5px 4px; border-top: 1px solid var(--border-subtle); color: var(--text-secondary); }
  .dash td.n { font-family: var(--font-family-mono); text-align: center; }
  .dash td.tot { font-family: var(--font-family-mono); text-align: end; color: var(--text-primary); }
  .dash .h0 { color: var(--text-muted); }
  .dash .h1 { background: color-mix(in srgb, var(--text-accent) 14%, transparent); }
  .dash .h2 { background: color-mix(in srgb, var(--text-accent) 26%, transparent); color: var(--text-primary); }
  .dash .h3 { background: color-mix(in srgb, var(--text-accent) 40%, transparent); color: var(--text-primary); }
  .dash tr.hot td:first-child { color: var(--text-primary); }
  .insight { display: flex; align-items: center; gap: 10px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-subtle); font-size: var(--text-small); color: var(--text-primary); }
  .insight::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: var(--radius-pill); background: var(--text-accent); }

  .beat-cta { min-height: 100vh; }
}
</style>
</head>
<body class="bg-surface-deep text-fg antialiased" data-scene="hero">
<a class="skip" href="#main">Skip to content</a>

<!-- Signature motion. Purpose: shows one set of Meerana building blocks (the logo's isometric cell) becoming each
     operating environment in turn — and, in the story, the cause and effect from problem to outcome — which static
     layout cannot. One fixed WebGL canvas for the whole page (meerana-webgl-scenes: one context per page).
     LCP is the H1 text; the hero poster SVG is the identical first frame; WebGL mounts after first paint.
     Loops (the core's breathing, flow lines, smoke) stop with the header's "Pause motion" control (WCAG 2.2.2). -->
<div id="stage" class="stage" data-signature aria-hidden="true">
  <div class="rect-main probe"></div>
  <div class="posters">{{M3_HERO_POSTER}}</div>
  <canvas></canvas>
  <div class="ovl" data-illustrative>
    <div data-ovl="sec" data-anchor="target" style="--bw:1.5;--bh:2.1"><div class="bracket"><span></span><span></span><span></span><span></span></div>
      <span class="chip danger"><i></i>Restricted zone · entry</span></div>
    <div data-ovl="bay2 bay3" data-anchor="smoke" style="--bw:2.6;--bh:4.4"><div class="bracket"><span></span><span></span><span></span><span></span></div>
      <span class="chip danger"><i></i>Smoke <b>0.94</b> · CAM-07</span></div>
    <div data-ovl="bay3" data-anchor="phone"><span class="chip left"><i></i>Alert → duty officer · clip 00:30</span></div>
    <div data-ovl="bay3" data-anchor="task"><span class="chip left"><i></i>Task R-0142 · open</span></div>
    <div data-ovl="bay5" data-anchor="task"><span class="chip left"><i></i>R-0142 · closed · one record</span></div>
    <div data-ovl="bars" data-anchor="peak"><span class="chip"><i></i>Bay 3 · <b>6 of 7</b> after hours</span></div>
    <div data-ovl="world" data-anchor="dubai"><span class="chip"><i></i>Dubai · headquarters</span></div>
    <div data-ovl="world" data-anchor="london"><span class="chip left"><i></i>London</span></div>
    <div data-ovl="world" data-anchor="egypt"><span class="chip left"><i></i>Egypt</span></div>
    <div data-ovl="world" data-anchor="chennai"><span class="chip"><i></i>Chennai</span></div>
    <div data-ovl="layer0" data-anchor="plate"><span class="chip"><i></i>01 · Mandoobee</span></div>
    <div data-ovl="layer1" data-anchor="plate"><span class="chip"><i></i>02 · Tasree3</span></div>
    <div data-ovl="layer2" data-anchor="plate"><span class="chip"><i></i>03 · Nazo</span></div>
    <div data-ovl="layer3" data-anchor="plate"><span class="chip"><i></i>04 · Yisbir</span></div>
    <div data-ovl="layer4" data-anchor="plate"><span class="chip"><i></i>05 · Asset Tracking</span></div>
    <div data-ovl="layer5" data-anchor="plate"><span class="chip"><i></i>06 · AI in a Box</span></div>
  </div>
  <p class="stage-note tag">Sample scenario · illustrative data</p>
</div>

<header class="site-header">
  <div class="wrap flex h-[72px] items-center justify-between gap-4">
    <a href="#top" class="flex shrink-0 items-center" aria-label="Meerana Technologies — home">
      <img src="{{LOGO_MEERANA_H}}" width="{{LOGO_MEERANA_H_W}}" height="{{LOGO_MEERANA_H_H}}" alt="Meerana Technologies" class="h-7 w-auto">
    </a>
    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-8 text-ui text-fg-secondary">
        <li><a class="hover:text-fg" href="#layer">Ecosystem</a></li>
        <li><a class="hover:text-fg" href="#story">How it works</a></li>
        <li><a class="hover:text-fg" href="#contact">Contact</a></li>
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <p class="hidden font-mono text-mono uppercase text-fg-muted xl:block" aria-hidden="true"><span class="text-fg" data-ch-no>01</span> / 05 · <span data-ch-name>Intelligence</span></p>
      <button type="button" class="mono-btn" data-motion-toggle data-motion-control aria-pressed="false">Pause motion</button>
      <a class="btn-outline hidden sm:inline-flex" href="#contact">Talk to Meerana</a>
    </div>
  </div>
  <span class="progress" aria-hidden="true"></span>
</header>

<main id="main">
  <!-- 01 · HERO ----------------------------------------------------------------------------------->
  <section id="top" class="chapter" data-chapter="01" data-chapter-name="Intelligence" aria-labelledby="hero-title">
    <div class="beat beat-hero" data-beat="hero">
      <div class="wrap w-full"><div class="col">
        <p class="eyebrow"><span data-ev="EV-001">Meerana Technologies</span> · Dubai, UAE · <span data-ev="EV-020">Est. 2022</span></p>
        <h1 id="hero-title" class="mt-5 font-light text-display-xl text-balance text-fg">We engineer intelligence <span class="text-fg-secondary">for the real world.</span></h1>
        <ol class="moments mt-10" aria-label="Four moments: AI, automation, IoT, security">
          <li><button type="button" class="moment" data-moment="ai" aria-pressed="false" data-ev="EV-520">
            <span class="m-no">01</span><span class="m-name">AI</span><span class="m-prod">AI in a Box</span><span class="m-cap">Reads, drafts, flags</span><span class="m-arrow" aria-hidden="true">→</span></button></li>
          <li><button type="button" class="moment" data-moment="auto" aria-pressed="false" data-ev="EV-401 EV-402 EV-403">
            <span class="m-no">02</span><span class="m-name">Automation</span><span class="m-prod">Tasree3</span><span class="m-cap">Re-engineers, mines, governs</span><span class="m-arrow" aria-hidden="true">→</span></button></li>
          <li><button type="button" class="moment" data-moment="iot" aria-pressed="false" data-ev="EV-100 EV-103">
            <span class="m-no">03</span><span class="m-name">IoT</span><span class="m-prod">Wasel</span><span class="m-cap">Opens gates from your phone</span><span class="m-arrow" aria-hidden="true">→</span></button></li>
          <li><button type="button" class="moment" data-moment="sec" aria-pressed="false" data-ev="EV-134 EV-138 EV-537">
            <span class="m-no">04</span><span class="m-name">Security</span><span class="m-prod">Yisbir</span><span class="m-cap">Flags fire, PPE, intrusion</span></button></li>
        </ol>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-3">
          <a class="btn-primary" href="#layer">Explore the ecosystem</a>
          <a class="link-arrow" href="#contact">Talk to Meerana <span aria-hidden="true">→</span></a>
        </div>
        <p class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-mono uppercase text-fg-muted">
          <span title="Blue Bay Tower, Business Bay">25.1876°N 55.2680°E</span><span aria-hidden="true">·</span><span>Fig. 1 — The core and its four inputs</span>
          <button type="button" class="mono-btn ms-1" data-replay>Replay</button>
