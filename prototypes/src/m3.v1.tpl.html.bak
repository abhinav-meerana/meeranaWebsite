            {{M3_DASH_ROWS}}
          </table>
          <figcaption id="dash-insight" class="insight">{{M3_DASH_INSIGHT}}</figcaption>
        </figure></div></div></li>
      <li class="beat step" data-beat="story-5"><div class="wrap w-full"><div class="col card-m">
        <p class="eyebrow">05 · Business outcome</p>
